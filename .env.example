NODE_ENV=development
PORT=4000
API_RATE_LIMIT_PER_MINUTE=600
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_pos?replicaSet=rs0&directConnection=true
# npm run setup generates a random JWT_SECRET and SEED_OWNER_PASSWORD.
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
SEED_OWNER_NAME=Restaurant Owner
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=
LOG_LEVEL=info
